# run-dev-docker.sh 的本地配置，覆盖 .env 和 backend/.env 中的同名参数。
# 默认使用本脚本管理的 PostgreSQL；容器之间使用服务名和容器端口。
DATABASE_URL=postgres://postgres:postgres@postgres:5432/getgpt?sslmode=disable

# 未配置的登录与 Session 密钥会在首次运行时生成并保存到 .env.docker。
# 已在 .env / backend/.env 配置的密钥会继续使用。

# 可选覆盖项
# FRONTEND_PORT=15680
# BACKEND_PORT=15681
# DB_PORT=15682
# APP_BASE_URL=http://localhost:15680
# DEV_WAIT_TIMEOUT=120
# 开发网络子网；与已有 Docker 网络、局域网或 VPN 冲突时换成未占用的私有网段。
# DEV_NETWORK_SUBNET=10.253.0.0/24
