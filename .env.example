# 服务端口与站点地址
FRONTEND_PORT=15680
BACKEND_PORT=15681
DB_PORT=15682
APP_BASE_URL=http://localhost:15680

# PostgreSQL 数据库
# 填写可访问的现有数据库连接，无需引号；未设置时本地开发使用默认连接。
# DATABASE_URL=postgres://user:password@host.docker.internal:15682/getgpt?sslmode=disable&TimeZone=Asia/Shanghai

# 服务部署（scripts/deploy.sh，仅部署前后端）
# 部署必须设置 DATABASE_URL；部署脚本不会创建或迁移数据库。
# FRONTEND_BIND_HOST=0.0.0.0
# BACKEND_BIND_HOST=127.0.0.1
# 构建默认最多使用 Docker 服务端 CPU 的 50%；单核限 0.5 核。
# BUILD_CPU_COUNT 可选，只用于进一步降低构建上限，超过 50% 会自动截断。
# BUILD_CPU_COUNT=1
# COMPOSE_PARALLEL_LIMIT=1
# DEPLOY_WAIT_TIMEOUT=120
# DEPLOY_BUILDER_NAME=aitok-production-builder

# 超级管理员
# 修改后重启后端生效，仅支持密码登录。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456

# 登录与 Session 加密
# JWT_SECRET 至少 32 个字符，可使用 openssl rand -hex 32 生成。
# SESSION_ENCRYPTION_KEY 使用 openssl rand -base64 32 生成，需长期保留。
JWT_SECRET=
SESSION_ENCRYPTION_KEY=

# 邮件发送 · Cloudflare Email Sending
MAIL_PROVIDER=cloudflare
MAIL_FROM_ADDRESS=no-reply@toktopup.com
MAIL_FROM_NAME=AiTok
MAIL_APP_BASE_URL=http://localhost:15680
MAIL_CODE_EXPIRE_MINUTES=10
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
CLOUDFLARE_EMAIL_API_BASE_URL=https://api.cloudflare.com/client/v4

# Stripe 支付
# 沙盒单次充值价格：1 USD / 100 USD。
# 本地 Stripe CLI 与线上 Webhook 端点使用各自的签名密钥。
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_1_PRICE_ID=price_1UEpzZBpVFyADK24y9lszR9t
STRIPE_100_PRICE_ID=price_1UEq0pBpVFyADK24MOR6FUDL

# 钱包代币与会员续订
# TOKENS_PER_USD：每美元兑换代币数。
# RENEWAL_TOKEN_COST：每次续订消耗代币数；RENEWAL_MONTHS：每次续订月数。
TOKENS_PER_USD=1
RENEWAL_TOKEN_COST=20
RENEWAL_MONTHS=1
